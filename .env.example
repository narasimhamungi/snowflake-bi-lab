# Postgres gold layer (same variables as marketdata-lakehouse)
MDL_DB_HOST=localhost
MDL_DB_PORT=5432
MDL_DB_NAME=marketdata_lakehouse
MDL_DB_USER=mdl
MDL_DB_PASSWORD=mdl_local_dev

# Snowflake. Key-pair auth is the supported path.
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=your_user
# ACCOUNTADMIN is only needed for the one-time sql/00_setup.sql; use a dedicated role afterwards.
SNOWFLAKE_ROLE=
# First run: a warehouse that already exists (trial accounts have COMPUTE_WH); 00_setup.sql then creates MARKETDATA_WH.
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_PRIVATE_KEY_PATH=C:\path\to\rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# SNOWFLAKE_PASSWORD=          # discouraged; only if key-pair is unavailable
